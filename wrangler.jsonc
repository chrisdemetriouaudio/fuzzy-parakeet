// chrisdemetriou.com on Cloudflare Workers.
//   Test:     npm test             (headers, allowlist, video ranges)
//   Preview:  npm run dev          (http://127.0.0.1:8790)
//   Deploy:   automatic on merge to main (.github/workflows/deploy-site.yml), or npx wrangler deploy
//   Check:    npm run parity -- <address>
// The repo root is the assets folder; .assetsignore lists the only files that go live.
// worker/build.mjs runs before every dev and deploy: it hashes the pages' inline scripts
// for the Content-Security-Policy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chrisdemetriou-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // The live site (cutover from GitHub Pages, Phase 9 step 2). www redirects to the apex in
  // worker/index.js. The first route is the address `npm run parity` checks by default.
  "routes": [
    { "pattern": "chrisdemetriou.com", "custom_domain": true },
    { "pattern": "www.chrisdemetriou.com", "custom_domain": true }
  ],
  "build": { "command": "node worker/build.mjs" },
  // The lead chat (Phase 9): "on" since Chris approved the privacy notice (22 Oct 2026).
  // "preview" shows it only on ?chat=preview links; "off" hides it and the form takes over.
  // Secrets (wrangler secret put): SESSION_SECRET, IP_HASH_SALT, TURNSTILE_SECRET, RESEND_API_KEY.
  "vars": {
    "CHAT_ENABLED": "on",
    // Fact buttons and the summary card (D35): "off", "preview" (?chat=preview links only) or "on".
    "CHAT_NEXT": "preview",
    "ADMIN_EMAIL": "hello@chrisdemetriou.com",
    // Public site key of the existing "Chris Demetriou contact form" Turnstile widget
    // (chrisdemetriou.com). Its secret goes in TURNSTILE_SECRET.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEGNlR_vCGl4yDDs"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // The chat model (MODEL_ID in worker/config.js), on the free tier with a daily cap.
  "ai": { "binding": "AI" },
  // Leads, chats and portal data. Created by Actions → Infra → d1-create (Western Europe);
  // the deploy applies migrations/ before each release.
  "d1_databases": [
    { "binding": "DB", "database_name": "chrisdemetriou-leads", "database_id": "dae5accf-567d-498c-8552-ad09a147b70f", "migrations_dir": "migrations" }
  ],
  // The showreel is 93 MB, over the 25 MiB limit for one static asset (D16).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "chrisdemetriou-media" }
  ]
}
