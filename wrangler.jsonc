{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chrisdemetriou-v2",
  "main": "src/site.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./v2",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "chrisdemetriou.com/*",
      "zone_name": "chrisdemetriou.com"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
