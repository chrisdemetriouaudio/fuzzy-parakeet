// chrisdemetriou.com on Cloudflare Workers.
//   Test:     npm test             (headers, allowlist, video ranges)
//   Preview:  npm run dev          (http://127.0.0.1:8790)
//   Deploy:   npx wrangler deploy  (until the cutover, this updates https://preview.chrisdemetriou.com)
//   Check:    npm run parity -- <address>
// The repo root is the assets folder; .assetsignore lists the only files that go live.
// worker/build.mjs runs before every dev and deploy: it hashes the pages' inline scripts
// for the Content-Security-Policy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chrisdemetriou-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // The preview, on Chris's own domain rather than the account's workers.dev name (D23).
  // At the cutover this becomes chrisdemetriou.com and www.chrisdemetriou.com.
  "routes": [
    { "pattern": "preview.chrisdemetriou.com", "custom_domain": true }
  ],
  "build": { "command": "node worker/build.mjs" },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // The showreel is 93 MB, over the 25 MiB limit for one static asset (D16).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "chrisdemetriou-media" }
  ]
}
