{
  "name": "chrisdemetriou-site",
  "private": true,
  "type": "module",
  "description": "chrisdemetriou.com on Cloudflare Workers: the static site, the showreel from R2, and (later) the lead chat and portal.",
  "scripts": {
    "build": "node worker/build.mjs",
    "test": "node worker/build.mjs && node --test worker/test/*.test.mjs",
    "dev": "wrangler dev --port 8790 --ip 127.0.0.1",
    "check": "npm test && wrangler deploy --dry-run --outdir .wrangler/dryrun",
    "parity": "node worker/parity.mjs"
  },
  "devDependencies": {
    "wrangler": "4.151.1"
  }
}
